{
  "name": "dsh-memory-snapshot",
  "version": "0.3.0",
  "description": "Zero-dependency DeepSeek Harness plugin: inject local markdown/text files into every session's system prompt as lightweight memory.",
  "type": "module",
  "main": "dist/index.js",
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist/",
    "install.mjs",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "node --check dist/index.js && node --check install.mjs",
    "smoke": "dsh --profile headless --dump-config | grep memory-snapshot",
    "prepublishOnly": "npm run build",
    "test": "node tests/test.mjs unit && node tests/test.mjs e2e"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "memory",
    "cordis"
  ],
  "license": "MIT",
  "author": "E_Ye <E_Ye@outlook.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yzx4036/dsh-memory-snapshot.git"
  },
  "devDependencies": {
    "typescript": "^5.7.0"
  }
}
